# Ubuntu 22.04 build environment = same toolchain the lab assumes (gcc-arm-linux-gnueabihf)
FROM ubuntu:22.04
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential git wget curl ca-certificates bison flex libncurses-dev libssl-dev libelf-dev \
    gcc-arm-linux-gnueabihf binutils-arm-linux-gnueabihf cpio bc xz-utils bzip2 file rsync kmod fakeroot \
    python3 python3-dev python3-setuptools swig libgnutls28-dev uuid-dev device-tree-compiler \
 && rm -rf /var/lib/apt/lists/*
